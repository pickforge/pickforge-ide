# PickForge — Tauri app (Rust core + SolidJS UI)

# Node / frontend
node_modules/
dist/
*.log

# Rust / Tauri
target/
src-tauri/gen/
# Staged Tauri sidecar (built by scripts/build-sidecar.mjs at bundle time)
src-tauri/binaries/

# Commit lockfiles for reproducible builds
!Cargo.lock

# Playwright (VRT)
test-results/
playwright-report/

# OS / editors
.DS_Store
.idea/
*.iml
.vscode/*
!.vscode/settings.json

# Local AI session caches
.superpowers/
.codex/
.claude/
.worktrees/

# Runtime state
/data/
.pickforge/

# iOS run pipeline build output (xcodebuild SYMROOT)
**/build/pickforge-ios/

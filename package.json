{
  "name": "pickforge-tauri",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:performance": "PICKFORGE_DEV_PORT=1422 vite",
    "build": "tsc --noEmit && vite build",
    "sidecar": "node scripts/build-sidecar.mjs",
    "build:tauri": "node scripts/build-sidecar.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:performance": "tauri dev --config src-tauri/tauri.performance.conf.json",
    "vrt": "playwright test",
    "e2e": "bun run tests/e2e/run.ts",
    "test:installer": "node tests/install-script.test.mjs",
    "lint": "eslint src tests --max-warnings 0",
    "test:unit": "vitest run && node tests/agent-schema-drift.test.mjs",
    "test:coverage": "vitest run --coverage",
    "fonts:data": "node scripts/generate-fonts-data.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.198",
    "@pickforge/auth": "^0.4.0",
    "@pickforge/brand": "0.2.1",
    "@pickforge/flags": "^0.4.0",
    "@pickforge/sync": "^0.6.0",
    "@pickforge/tauri-updater": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.3",
    "@yume-chan/stream-extra": "2.6.1",
    "dompurify": "^3.4.12",
    "marked": "^18.0.5",
    "solid-js": "^1.9.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pickforge/tauri-release": "^0.3.0",
    "@playwright/test": "^1.48.0",
    "@tauri-apps/cli": "^2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "8.65.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.9"
  }
}

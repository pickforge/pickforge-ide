{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PickForge",
  "version": "0.1.9",
  "identifier": "dev.pickforge.app",
  "mainBinaryName": "pickforge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PickForge",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0a0b",
        "dragDropEnabled": true
      }
    ],
    "enableGTKAppId": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.pickforge/pickforge-images/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pickforge/pickforge/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5RTg4QTkyMDFCNEZEOTYKUldTVy9iUUJrb3JvaWVaTUtLbGRoVmtjNlpYRlVBekU2RUlINzFaZDBWQytBaDBNQkhtekxBV0wK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/pickforge-mcp",
      "binaries/pickforged",
      "binaries/pickforge-claude-bridge"
    ],
    "resources": {
      "../scripts/claude-bridge.ts": "scripts/claude-bridge.ts"
    },
    "category": "DeveloperTool",
    "shortDescription": "Forge UI from your terminal",
    "longDescription": "A shell-first workbench that drives Claude, Codex, and your build tools from an embedded terminal, with a Rust core for PTY, device bridges, and storage.",
    "copyright": "© PickForge · MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
